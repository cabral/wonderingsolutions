---
import Base from '../layouts/Base.astro';
import CirclePlan from '../components/CirclePlan.astro';
import Notify from '../components/Notify.astro';
import VideoEmbed from '../components/VideoEmbed.astro';

const thenAndNow = [
  ['Circles with rotating leadership and the five agreements', 'The same circles, plus pods of four that run from a written guide'],
  ['Everything held by the founders', 'A written guide for every part that must outlive the founder'],
  ['The Friday open door', 'The open door, now a monthly commons evening at Klustret'],
  ['Nothing mandatory', 'One commitment: pod attendance'],
  ['Success told as stories', 'Outcomes counted at six and twelve months'],
];

const rings = [
  { ring: 'You', size: '1, daily', job: 'Take the step, keep the loggbok', held: 'The participant' },
  { ring: 'Pod', size: '4, weekly, 1 hour', job: 'Witness traces, resize steps, name obstacles', held: 'A rotating member, from a written guide' },
  { ring: 'Cohort', size: 'About 12, weekly circle', job: 'See peers move; first showing of work', held: 'Pirates, the programme\'s facilitators' },
  { ring: 'Commons', size: 'Open, monthly', job: 'Host, ask, offer, meet strangers', held: 'Hosts from the cohort and alumni' },
  { ring: 'Their own people', size: 'From zero, when they host', job: 'The dream\'s own community', held: 'The participant' },
];

const week = [
  {
    title: 'The step card',
    text: 'On Sunday she writes down one step: email two bakers on Södermalm and ask each for twenty minutes. She will do it after Tuesday dinner, at the kitchen table. If it goes nowhere, she loses an hour and a little pride.',
  },
  {
    title: 'The step, alone',
    text: 'On Tuesday she writes the emails and starts rewriting them. Her card has a line for that: "If I start rewriting, then I send it as it is." She sends them.',
  },
  {
    title: 'The pod, one hour',
    text: 'Four people, a written script, no facilitator. Maria shows the two sent emails. Each of the others names one thing she did. Then she reads out her next step: visit the baker who answered.',
  },
  {
    title: 'The circle, one evening',
    text: 'The cohort of twelve meets with the two or three people who hold the programme, called pirates. Around it there is a weekly one-to-one with a pirate, workshops on tools, and time for making things side by side.',
  },
  {
    title: 'The commons, once a month',
    text: 'In week nine Maria hosts twenty minutes on sourdough at Klustret and asks the room one question: who knows a café that would sell twelve loaves on a Saturday? If someone says yes, her dream has its first commitment from outside.',
  },
];

const needs = [
  'Rooms, booked and paid for like any member booking. Arenan fits the circle and the commons, and Utsikten fits a pod of four.',
  'One open commons evening a month on Klustret\'s programme.',
  'A contact person at Klustret, and a shared review when the thirteen weeks end.',
];

const gets = [
  'A monthly evening of member-led sessions by people building something.',
  'A path for newcomers: visitor, then host, then participant, later pod guide or pirate.',
  'A programme written down to run without its founder in the room.',
  'Counted results, shared in full.',
];

const backIt = [
  'If you\'d like to see this at Klustret, say so. A proposal with members behind it gets a different hearing.',
  'Come to the first commons evening.',
  'Think of one person in a transition who should hear about this, and tell them.',
  'Offer a workshop on a tool you use. Workshops are proposed, never required, and an hour is enough.',
  'Consider holding a cohort as a pirate. It asks for steadiness more than charisma, and a twelve-hour course in mental health first aid.',
  'Tell me what would make you say no. I know some of the weak spots and would like to hear the ones I missed.',
];

const phases = [
  { name: 'Before the first circle', text: 'Screening conversations with every applicant. Pirates trained. Pods formed among people who don\'t know each other.' },
  { name: 'During the thirteen weeks', text: 'Weekly pods without pirates, a weekly circle with them, and one commons evening a month.' },
  { name: 'After', text: 'Each pod decides whether to keep meeting. Follow-up at six and twelve months, shared with Klustret.' },
];
---
<Base
  title="Estaleiro: Self-Directed Entrepreneurship"
  description="Estaleiro Liberdade, a Brazilian self-directed entrepreneurship programme from 2012, and an open proposal to relaunch it in Stockholm with Klustret Ekskäret as Freedom Shipyard."
>
  <div class="wrap">
    <header class="page-head">
      <p class="label eyebrow">Estaleiro Liberdade, Porto Alegre 2012</p>
      <h1 class="display estaleiro-title">A school of entrepreneurship through <span class="nowrap">self-knowledge.</span> But pirate.</h1>
      <div class="column prose intro">
        <p class="lede">
          That was the tagline, and it was accurate. Estaleiro Liberdade, Freedom Shipyard in
          English, began in 2012 in a shared house at Rua Liberdade 553 in Porto Alegre. Every
          Friday a group of us opened the house for free sessions where anyone could teach or learn
          something, and the programme grew out of that open door. The first cohort of five started
          in August 2012. By 2013 cohorts had about twelve people, and in 2014 the programme opened
          in São Paulo.
        </p>
        <p>
          I co-founded it and served as president of the formal organisation. My part ran through
          2015.
        </p>
      </div>
    </header>

    <div class="videos">
      <VideoEmbed
        id="751187741"
        hash="dcdf015080"
        title="Estaleiro Liberdade"
        caption="Estaleiro Liberdade"
        duration="2 min 45 s"
      />
      <VideoEmbed id="75667105" hash="e07edc13d8" title="Video" />
    </div>

    <section class="section first" aria-labelledby="how">
      <h2 id="how">How it worked</h2>
      <div class="column prose">
        <p>
          Journeys ran three to four months. Participants were called sailors, facilitators were
          pirates, and nobody had a curriculum. No grades, no reading lists, no attendance
          requirement. Everything was proposed and nothing was mandatory.
        </p>
        <p>
          Four kinds of gathering: conversation circles, workshops on methods, hands-on sessions on
          your own project, and individual mentoring. The toolkit came from wherever it worked,
          including Nonviolent Communication, design thinking, Dragon Dreaming and agile.
        </p>
        <p>Three principles held it together.</p>
      </div>

      <div class="plan-wrap">
        <CirclePlan />
      </div>

      <div class="column prose">
        <p>
          Before we started, I travelled through Europe visiting multiple schools
          in Europe and being inspired by Kaos Pilot and Knowmads. In 2013 a
          second expedition visited nine more schools, crowdfunded on Catarse. What we found there
          shaped the model.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="out">
      <h2 id="out">What came out of it</h2>
      <div class="column prose">
        <p>
          Projects, small ones, which is what happens when cohorts are a dozen people. Herói Postal,
          from the first cohort, turned emails into handwritten letters written by people in
          hospital, who shared the income. Ninho de Escritores, a project for writers, began there,
          and one facilitator went on to create Programa Travessia, a programme for career
          transitions.
        </p>
        <p>
          What ended it was dependence on its founders. The programme ran on our attention, and when
          that attention moved to other ventures, it stopped, around 2016.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="sthlm">
      <h2 id="sthlm">Stockholm</h2>
      <div class="column prose">
        <p>
          Klustret Ekskäret is a community and coworking space on Odengatan, started in 2016 by
          Stiftelsen Ekskäret, a foundation Tomas Björkman set up in 2008. The foundation runs two
          places: Klustret in the city, and an island in a nature reserve out in the Stockholm
          archipelago. Weekdays Klustret is somewhere to work. Evenings and weekends it turns into
          whatever the members decide to run there.
        </p>
        <p>
          Klustret calls itself a lab and an experiment in self-organisation. Members sit in
          circles, each one responsible for an area, and the whole thing runs on six principles
          about taking responsibility for your own contribution, showing up as you are, sharing what
          you have, acting before you're certain, and everyone being a host rather than a guest.
        </p>
        <p>
          I recognised all of that. Estaleiro ran on rotating leadership, shared responsibility, and
          circle agreements about listening without judgement and treating silence as part of the
          conversation. Different country, different decade, the same bet: people work out what to
          build by working on themselves, in a group that holds them to it.
        </p>
        <p>
          Klustret is also an Inner Development Goals hub. IDG is the vocabulary that didn't exist
          in 2012, when we called it <span lang="pt">autoconhecimento</span> and had to explain it
          every single time.
        </p>
        <p>
          I'm a member, and I've written a proposal for relaunching Estaleiro there under the
          working name Freedom Shipyard. Nothing is agreed yet. The rest of this page is that
          proposal, published while it's still open so anyone can read it and push back.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="idea">
      <h2 id="idea">The proposal</h2>
      <div class="column prose">
        <p class="lede">
          People grow a dream through small steps they take alone. A group of four keeps them going,
          and a wider community gives the dream somewhere to become real.
        </p>
        <p>
          Freedom Shipyard is a thirteen-week programme for people in a transition: between jobs,
          changing direction, or carrying a project they keep not starting. Each person works on
          their own dream, at their own pace.
        </p>
        <p>
          Each week a participant takes one small step alone, sized so it can be done on a bad day.
          They show what the step left behind to a pod, four people who meet for an hour with no
          facilitator. The pod celebrates what was done and helps with the next step. A step that
          didn't happen was too big, so the pod helps shrink it.
        </p>
        <p>
          About twelve people form a cohort and meet in a weekly circle. Once a month the programme
          opens its door at Klustret: participants host short sessions on what they are building,
          and members and guests come to ask and to offer. That evening is called the commons.
        </p>
        <p>
          A dream counts as real when someone outside the programme commits something to it: an
          hour, a room, money or their name. Nobody is pushed to launch. A person who keeps a daily
          practice for thirteen weeks and never launches has done the work too, and every step is
          celebrated.
        </p>
      </div>

      <h3 class="title sub">Five rings</h3>
      <div class="column prose">
        <p>
          Five rings carry the support. Each person moves outward one ring at a time, at their own
          pace: practice alone, then show, then ask. The pod looks after the person, and the commons
          looks after the dream.
        </p>
      </div>
      <div class="table-scroll">
        <table class="grid-table">
          <caption class="visually-hidden">The five rings of Freedom Shipyard</caption>
          <thead>
            <tr>
              <th scope="col">Ring</th>
              <th scope="col">Size and rhythm</th>
              <th scope="col">Job</th>
              <th scope="col">Held by</th>
            </tr>
          </thead>
          <tbody>
            {rings.map((r) => (
              <tr>
                <th scope="row">{r.ring}</th>
                <td>{r.size}</td>
                <td>{r.job}</td>
                <td>{r.held}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="title sub">What changes from Porto Alegre</h3>
      <div class="table-scroll">
        <table class="grid-table">
          <caption class="visually-hidden">Estaleiro in Porto Alegre compared with the Stockholm proposal</caption>
          <thead>
            <tr>
              <th scope="col">Porto Alegre, 2012 to 2016</th>
              <th scope="col">Stockholm</th>
            </tr>
          </thead>
          <tbody>
            {thenAndNow.map(([then, now]) => (
              <tr>
                <td>{then}</td>
                <td>{now}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="week">
      <h2 id="week">A week inside</h2>
      <div class="column prose">
        <p class="lede">
          An invented example, to show the size of things. Maria wants to open a small bakery and has
          never sold a loaf.
        </p>
        <ol class="steps">
          {week.map((s) => (
            <li>
              <h3 class="steps__title">{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
        <p class="small">
          Someone else in her pod may spend the same weeks on a daily writing practice and never
          show it to anyone outside. Both are doing the programme as designed.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="known">
      <h2 id="known">What is known, and what isn't</h2>
      <div class="column prose">
        <p class="lede">
          The method is built from research on how people act on their goals. Its parts have been
          tested. The whole has not.
        </p>
        <h3 class="title">What the research supports</h3>
        <ul class="bullets">
          <li>
            Writing progress down and showing it to other people raises the chance of reaching a goal
            (138 experiments, about 20,000 people).
          </li>
          <li>
            Tying an action to a time and a place helps people do it (94 tests). It holds best for
            single actions, which is what a weekly step is.
          </li>
          <li>
            Job-search programmes built from the same ingredients raised the odds of finding work
            2.67 times across 47 evaluations. That is a neighbouring field, with different people.
          </li>
        </ul>
        <h3 class="title">What nobody knows yet</h3>
        <p>
          Nobody has tested this combination. The original programme left stories and no counts.
          Twelve people are too few to prove an effect, so the first cohort is a pilot with four
          questions: does it run, do people keep taking steps, does anyone get hurt, and do the pods
          hold without me in the room.
        </p>
        <h3 class="title">What gets counted and shared</h3>
        <p>
          Every week: steps taken, shrunk and missed, commitments from people outside, and everyone
          who leaves, with their reason. At six and twelve months: projects shipped, changes in work
          or income, and pods still meeting. Klustret sees all of it, including what went badly.
        </p>
        <p class="aside">
          Safety is planned before the first circle: a screening conversation with every applicant,
          pirates trained in mental health first aid, a right to pass on anything, and a referral
          list in every room.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="klustret">
      <h2 id="klustret">What it needs from Klustret</h2>
      <div class="column prose">
        <p>
          Klustret already gathers entrepreneurs, thinkers and people working for change, and runs
          dialogues, workshops and events on the conscious development of people and organisations.
          Freedom Shipyard needs that kind of place for its commons, and I'd like the first cohort to
          live there.
        </p>
      </div>
      <div class="two-col">
        <div>
          <h3 class="title">It needs</h3>
          <ul class="bullets">
            {needs.map((n) => <li>{n}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="title">Klustret gets</h3>
          <ul class="bullets">
            {gets.map((g) => <li>{g}</li>)}
          </ul>
        </div>
      </div>
      <div class="column prose">
        <p class="aside">
          Money is left out of the proposal on purpose. Rooms are rented at the member rate. How the
          rest is paid for will be worked out with the people involved, in financial circles drawing
          on Dominic Barter's work.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="back">
      <h2 id="back">How to back it</h2>
      <div class="column prose">
        <p class="lede">
          The pilot is one cohort of about twelve people, in three pods of four, for thirteen weeks.
          Six things would help it happen.
        </p>
        <ol class="numbered">
          {backIt.map((b) => <li>{b}</li>)}
        </ol>
      </div>
      <dl class="phases">
        {phases.map((p) => (
          <div class="field">
            <dt>{p.name}</dt>
            <dd>{p.text}</dd>
          </div>
        ))}
      </dl>
      <div class="notify-wrap">
        <Notify list="estaleiro" lead="Find me at Klustret, or leave your email and I'll write when there's news." />
      </div>
    </section>
  </div>
</Base>

<style>
  .eyebrow {
    margin-bottom: var(--space-4);
  }

  .estaleiro-title {
    max-width: 20ch;
  }

  .nowrap {
    white-space: nowrap;
  }

  .intro {
    margin-top: var(--space-8);
  }

  .videos {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  @media (min-width: 900px) {
    .videos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .first {
    padding-top: var(--space-8);
  }

  .plan-wrap {
    margin-block: var(--space-12);
  }

  .sub {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .prose > h3 {
    margin-top: var(--space-8);
  }

  .table-scroll {
    overflow-x: auto;
    max-width: 48rem;
    margin-top: var(--space-4);
  }

  .grid-table {
    width: 100%;
    border-collapse: collapse;
  }

  .grid-table th,
  .grid-table td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-2) var(--space-4) var(--space-2) 0;
  }

  .grid-table thead th {
    font: var(--label);
    color: var(--ink-soft);
  }

  .grid-table tbody th,
  .grid-table tbody td {
    border-top: var(--stroke-hair) solid var(--line);
  }

  .grid-table tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  .grid-table tbody tr:last-child > * {
    border-bottom: var(--stroke-hair) solid var(--line);
  }

  .steps {
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: var(--space-2);
    border-top: var(--stroke-hair) solid var(--line);
    padding-block: var(--space-4);
  }

  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    font: var(--title);
  }

  .steps__title {
    font-weight: 600;
  }

  .bullets,
  .numbered {
    padding-left: 1.25em;
  }

  .bullets li + li,
  .numbered li + li {
    margin-top: var(--space-2);
  }

  .aside {
    background: var(--raised);
    padding: var(--space-4);
  }

  .two-col {
    display: grid;
    gap: var(--space-8);
    max-width: 56rem;
    margin-block: var(--space-8);
  }

  .two-col .title {
    margin-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .two-col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .phases {
    display: grid;
    gap: var(--space-4);
    max-width: 56rem;
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .phases {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }

  .notify-wrap {
    margin-top: var(--space-8);
  }
</style>
