---
// A responsive Vimeo player in the site's frame. Loads lazily, with Vimeo's
// do-not-track flag on so nothing is set until the visitor presses play.
interface Props {
  id: string;
  hash?: string;
  title: string;
  caption?: string;
  duration?: string;
}
const { id, hash, title, caption, duration } = Astro.props;
const params = new URLSearchParams({ dnt: '1' });
if (hash) params.set('h', hash);
const src = `https://player.vimeo.com/video/${id}?${params}`;
---
<figure class="video">
  <div class="video__frame">
    <iframe
      src={src}
      title={title}
      loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>
  {(caption || duration) && (
    <figcaption class="video__caption">
      {caption && <span class="label">{caption}</span>}
      {duration && <span class="small">{duration}</span>}
    </figcaption>
  )}
</figure>

<style>
  .video {
    max-width: 48rem;
    background: var(--raised);
    border-top: var(--stroke-trail) solid var(--mark);
  }

  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--hakama);
  }

  .video__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-2) var(--space-4);
    font-variant-numeric: tabular-nums;
  }
</style>
